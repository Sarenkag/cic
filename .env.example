# Skopiuj do .env i uzupełnij. Nigdy nie wysyłaj tego pliku nikomu.

# Klucz Anthropic (console.anthropic.com). Bez niego raport poranny powstaje z szablonu.
ANTHROPIC_API_KEY=

# Losowy sekret do formularzy panelu: python3 -c "import secrets;print(secrets.token_hex(32))"
CIC_SECRET=

# Loginy dyrektorów: login:skrót_hasła, rozdzielone przecinkami.
# Skrót tworzysz poleceniem: docker compose run --rm cic python -m app.cli hash-password
# Login musi być taki sam jak klucz w sekcji directors w config/cic.yaml.
CIC_USERS=

# Opcjonalnie: odczyt danych spółki z Companies House (developer.company-information.service.gov.uk)
COMPANIES_HOUSE_API_KEY=

# Opcjonalnie: wysyłka raportu porannego e-mailem
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
